@model IEnumerable<StrayAnimalAdoption.Models.AdoptionApplication>
@{
    ViewData["Title"] = "領養申請審核";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">📋 領養申請審核管理</h2>
        <a asp-action="EmployeeIndex" class="btn btn-outline-secondary">🔙 返回員工後台</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>申請單號</th>
                            <th>申請日期</th>
                            <th>申請人姓名</th>
                            <th>申請毛孩</th>
                            <th>毛孩狀態</th>
                            <th>審核狀態</th>
                            <th class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">目前沒有任何領養申請單。</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td># @item.Aid</td>
                                <td>@item.Adate</td>
                                <td>
                                    <span class="fw-bold text-dark">@(item.MidNavigation?.Mname ?? "未知會員")</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Pid" target="_blank" class="text-decoration-none fw-bold">
                                        @(item.PidNavigation?.Pname ?? "未知毛孩") 🔗
                                    </a>
                                </td>
                                <td>
                                    @if (item.PidNavigation?.Status == "待領養")
                                    {
                                        <span class="badge bg-success">待領養</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">已領養</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Astatus == "審核中")
                                    {
                                        <span class="badge bg-warning text-dark">審核中</span>
                                    }
                                    else if (item.Astatus == "已核准")
                                    {
                                        <span class="badge bg-primary">已核准</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.Astatus</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Astatus == "審核中" && item.PidNavigation?.Status == "待領養")
                                    {
                                        <div class="d-flex gap-1 justify-content-center">
                                            <form asp-action="ApproveAdoption" method="post" onsubmit="return confirm('確定要核准這筆申請嗎？核准後該毛孩將自動轉為【已領養】狀態。');">
                                                <input type="hidden" name="aid" value="@item.Aid" />
                                                <button type="submit" class="btn btn-sm btn-success fw-bold">✔️ 核准</button>
                                            </form>
                                            <form asp-action="RejectAdoption" method="post" onsubmit="return confirm('確定要退回這筆申請嗎？');">
                                                <input type="hidden" name="aid" value="@item.Aid" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">❌ 拒絕</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">已結案</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>