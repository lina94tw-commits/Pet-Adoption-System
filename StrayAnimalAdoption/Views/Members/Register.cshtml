@model StrayAnimalAdoption.Models.Member
@{
    ViewData["Title"] = "加入會員";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">📝 建立領養人帳號</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">姓名</label>
                            <input asp-for="Mname" class="form-control" required placeholder="請輸入真實姓名" />
                            <span asp-validation-for="Mname" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">電子信箱 (Email)</label>
                            <input asp-for="Email" class="form-control" required type="email" placeholder="作未來登入帳號使用" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">設定密碼</label>
                            <input asp-for="Password" type="password" class="form-control" required placeholder="請設定登入密碼" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">聯絡電話</label>
                            <input asp-for="Phone" class="form-control" placeholder="例如：0912345678" />
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">通訊地址</label>
                            <input asp-for="Address" class="form-control" placeholder="請輸入聯絡地址" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">確認註冊並送出</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}